# Copy to .env and change every secret before exposing Langfuse beyond localhost.
# The INIT values create a project with known API keys on first start, so the agent can
# send traces without clicking through the UI.
NEXTAUTH_SECRET=change-me
SALT=change-me
LANGFUSE_INIT_ORG_ID=f1-agent
LANGFUSE_INIT_ORG_NAME=f1-agent
LANGFUSE_INIT_PROJECT_ID=f1-agent
LANGFUSE_INIT_PROJECT_NAME=f1-agent
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-f1-agent-local
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-f1-agent-local
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=change-me-too
